{
  "name": "@corbet-labs/cvld",
  "version": "0.1.0-alpha.0",
  "private": false,
  "description": "Experimental passkey authentication, community eligibility and encrypted client wallets",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./admission": "./src/admission.js",
    "./client": "./src/client.js",
    "./passkeys": "./src/passkeys.js",
    "./storage": "./src/sqlite.js",
    "./entry": "./src/entry.js",
    "./http": "./src/http.js",
    "./voucher-bridge": "./src/voucher-bridge.js",
    "./api-keys": "./src/api-keys.js",
    "./profile-policy": "./src/profile-policy.js",
    "./holder": "./src/browser-holder.js",
    "./holder-worker": "./src/holder-worker.js",
    "./holder-wasm": "./generated/holder/cvld_holder.js",
    "./holder-wasm-binary": "./generated/holder/cvld_holder_bg.wasm"
  },
  "files": [
    "src",
    "LICENSE.md",
    "README.md",
    "scripts",
    "generated/holder/cvld_holder.js",
    "generated/holder/cvld_holder.d.ts",
    "generated/holder/cvld_holder_bg.wasm",
    "generated/holder/cvld_holder_bg.wasm.d.ts"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "prepare:native": "node scripts/install-native.js"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cmtymeet/cvld.git"
  },
  "dependencies": {
    "@hyperledger/anoncreds-nodejs": "0.4.0",
    "@simplewebauthn/server": "14.0.1"
  },
  "devDependencies": {
    "@levischuck/tiny-cbor": "0.3.6",
    "playwright": "1.63.0"
  },
  "bin": {
    "cvld-install-native": "./scripts/install-native.js"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "homepage": "https://github.com/cmtymeet/cvld#readme",
  "bugs": {
    "url": "https://github.com/cmtymeet/cvld/issues"
  }
}
